# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Neon Postgres connection string (Neon dashboard → Connect → "Pooled connection"). Server-only, never NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# The live site's address, no trailing slash. Used for metadata, sitemap.xml, robots.txt and OG image URLs.
NEXT_PUBLIC_SITE_URL="https://abinasha.com.np"

# OpenWeather API key for the Weather Checker mini-app (/playground/weather-checker). Server-only.
OPENWEATHER_API_KEY=""

# Contact-form notification emails (resend.com → API Keys). Without it, messages are still saved to Neon
# and the email is skipped quietly. Server-only.
RESEND_API_KEY=""
# Where notifications go (your inbox).
CONTACT_TO_EMAIL=""
# Sender. Leave empty to use Resend's test sender "Portfolio <onboarding@resend.dev>", which can only
# deliver to your own Resend account's email. Once abinasha.com.np is verified in Resend, use e.g.
# "Portfolio <hello@abinasha.com.np>".
CONTACT_FROM_EMAIL=""
