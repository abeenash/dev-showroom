# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Neon Postgres connection string (Neon dashboard → Connect → "Pooled connection"). Server-only, never NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# The live site's address, no trailing slash. Used for metadata, sitemap.xml, robots.txt and OG image URLs.
NEXT_PUBLIC_SITE_URL="https://abinasha.com.np"

# OpenWeather API key for the Weather Checker mini-app (/playground/weather-checker). Server-only.
OPENWEATHER_API_KEY=""
